{
  "_comment": "价格体系专项巡检链路配置。默认用当前巡检登录账号做只读健康检查；如需按完整链路强断言，补充目标 UUID、历史 quote_no、ship_order_no 后开启对应块。",
  "defaults": {
    "language": "korean",
    "currency": "KRW",
    "nation": "Korea"
  },
  "cases": [
    {
      "name": "当前登录账号价格体系基础健康",
      "enabled": true,
      "login_account": "",
      "countryCode": "Korea",
      "useStoredCartDetailIds": true,
      "expected": {
        "minCheckCount": 1,
        "requireAnyAddon": true,
        "requirePricingSourceOnPricedItems": false
      },
      "cartPreview": {
        "enabled": true,
        "useStoredCartDetailIds": true,
        "checkUuid": "",
        "fjxUuids": [],
        "userFjxUuids": [],
        "expectedTotal": null
      },
      "snapshotChecks": [
        {
          "name": "附加项列表快照健康",
          "auth": "user",
          "path": "/api_b2b/cartQuoteStep1/getCheckFjxList",
          "body": {},
          "expectContains": ["check_data", "fjx_data"],
          "expectNotContains": []
        }
      ],
      "servicePricing": {
        "enabled": true,
        "expectNoBlankMemberLevel": true,
        "checkConfigUuid": "JPT-CHK-002",
        "fjxConfigUuid": "JPT-FJX-001"
      },
      "shipFjxChecks": [
        {
          "name": "发货附加项健康",
          "path": "/admin_b2b/shipOrderDetail/fjxList",
          "body": {
            "ship_order_no": "WL-KOR8-260709-010"
          },
          "requireAnyShipAddon": true,
          "requiredPricingSources": []
        }
      ]
    }
  ],
  "exampleStrongAssertions": {
    "expected": {
      "visibleCheckUuids": ["JPT-CHK-002"],
      "visibleFjxUuids": ["JPT-FJX-001"],
      "visibleUserFjxUuids": ["JPT-FJX-016"],
      "pricingSources": {
        "check:JPT-CHK-002": "country_level",
        "fjx:JPT-FJX-001": "country_level",
        "user_fjx:JPT-FJX-016": "user_custom"
      },
      "prices": {
        "user_fjx:JPT-FJX-016": 8.88
      },
      "forbiddenPrices": [99],
      "requirePricingSourceOnPricedItems": true
    },
    "snapshotChecks": [
      {
        "name": "报价详情快照保留 pricing_source",
        "auth": "user",
        "path": "/api_b2b/quoteDetail/detail",
        "body": {
          "quote_no": "B2B-BJ-PLACEHOLDER"
        },
        "expectContains": ["pricing_source"],
        "expectNotContains": ["99.00"]
      }
    ],
    "shipFjxChecks": [
      {
        "name": "发货附加项价格来源",
        "path": "/admin_b2b/shipOrderDetail/fjxList",
        "body": {
          "ship_order_no": "B2B-FH-PLACEHOLDER"
        },
        "requireAnyShipAddon": true,
        "requiredPricingSources": ["country_level"]
      }
    ]
  }
}
