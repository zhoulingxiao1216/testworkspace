# Agent DB config example.
# Copy this file to a project-local env file such as:
# {project}/测试文档/.env
#
# Never commit real passwords, tokens, private keys, or customer data.

AGENT_DB_DRIVER=mysql
AGENT_DB_MODE=readonly
AGENT_DB_ENV=test

AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=3306
AGENT_DB_NAME=example_test_db
AGENT_DB_USER=readonly_user
AGENT_DB_PASSWORD=
AGENT_DB_CHARSET=utf8mb4
AGENT_DB_CONNECT_TIMEOUT=10

# Optional SSH tunnel.
AGENT_DB_SSH_ENABLED=false
AGENT_DB_SSH_HOST=
AGENT_DB_SSH_PORT=22
AGENT_DB_SSH_USER=
AGENT_DB_SSH_PASSWORD=
AGENT_DB_SSH_PKEY=

# Mock write gates. Keep disabled unless Agent 2 must seed mock data.
AGENT_DB_ALLOW_MOCK_WRITE=false
AGENT_DB_REQUIRE_MOCK_MARKER=true
AGENT_DB_MOCK_TABLE_ALLOWLIST=
AGENT_DB_MOCK_DATABASE_PATTERN=(test|mock|dev|qa|staging)
AGENT_DB_ASSUME_NON_PROD=false

# Audit log contains no raw SQL by default, only hash/table/rowcount metadata.
AGENT_DB_AUDIT_LOG=.agent/memory/agent2-test-execution/db_mock_audit.jsonl
